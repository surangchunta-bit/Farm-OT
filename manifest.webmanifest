<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<title>Money Farm — HRM OT Calculator</title>
<meta name="description" content="แอปคำนวณ OT และบริหารเงินส่วนตัว ธีมเกมฟาร์ม — สแกนใบสรุปการทำงาน คำนวณเงิน OT ตามสูตรจริง แล้วดูว่าเดือนนี้เหลือใช้เท่าไหร่">
<meta name="theme-color" content="#FFB84D">
<meta name="color-scheme" content="light">

<!-- ไอคอน / PWA -->
<link rel="manifest" href="./manifest.webmanifest">
<link rel="icon" href="./favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="./icons/icon-512.png">
<link rel="apple-touch-icon" href="./icons/icon-180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Money Farm">
<meta name="application-name" content="Money Farm">
<meta property="og:type" content="website">
<meta property="og:title" content="Money Farm — HRM OT Calculator">
<meta property="og:description" content="กรอกชั่วโมง OT → รู้ทันทีว่าเดือนนี้เหลือใช้เท่าไหร่">
<meta property="og:image" content="./icons/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<style>
/* ---- ฟอนต์ฝังในไฟล์ (base64) ใช้ได้ทั้ง iOS / Android โดยไม่ต้องต่อเน็ต ---- */
@font-face{font-family:'Mali';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0E01-0E5B,U+200C-200D,U+25CC}
@font-face{font-family:'Mali';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Mali';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0E01-0E5B,U+200C-200D,U+25CC}
@font-face{font-family:'Mali';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Fredoka';font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}

@font-face{font-family:'Fredoka';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
:root{
  --bg:#FFF8E8; --primary:#FFB84D; --green:#7BC96F; --sky:#7DD3FC;
  --pink:#FF8FAB; --purple:#A78BFA; --gold:#FFD166; --text:#3D3D3D;
  --line:#EADFC6; --wood:#C98A5B; --woodD:#8B562F;
  --sky1:#8FD8FF; --sky2:#D9F2FF; --sun:#FFD166; --sunGlow:.30;
  --g1:#8FD07A; --g2:#6BBE5E; --g3:#57A84B; --veil:0; --lit:0;
  --safeB:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;background:#20303a;color:var(--text);
  font-family:'Mali','Noto Sans Thai',system-ui,sans-serif;-webkit-user-select:none;user-select:none}
.num{font-family:'Fredoka',system-ui,sans-serif;font-variant-numeric:tabular-nums}
button{font-family:inherit;cursor:pointer;border:0}

/* ============ shell ============ */
.app{position:fixed;inset:0;max-width:430px;margin:0 auto;overflow:hidden;background:#BFE9FF;
  box-shadow:0 0 50px rgba(0,0,0,.35)}
/* time themes */
.app.t-day  {--sky1:#7FD2FF;--sky2:#DFF6FF;--sun:#FFD86B;--sunGlow:.30;--g1:#93D67F;--g2:#6BBE5E;--g3:#57A84B;--veil:0;--lit:0}
.app.t-eve  {--sky1:#FF9E6B;--sky2:#FFE0B0;--sun:#FF8F5E;--sunGlow:.45;--g1:#8FBE72;--g2:#69A455;--g3:#4F8A43;--veil:.14;--lit:.85}
.app.t-night{--sky1:#1B2A5E;--sky2:#4A5FA8;--sun:#FFF3C4;--sunGlow:.22;--g1:#4C7A55;--g2:#3B6544;--g3:#2E5237;--veil:.34;--lit:1}

/* ============ farm scene ============ */
#farmSvg{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:manipulation}
#farmSvg text{font-family:'Mali',sans-serif;-webkit-user-select:none}
.veil{transition:opacity .9s}
.stars,.ff{opacity:0;transition:opacity 1s}
.t-night .stars,.t-night .ff{opacity:1}
.win{opacity:0;transition:opacity .8s}
.app.t-eve .win,.app.t-night .win{opacity:1}

/* spot = tappable building */
.spot{cursor:pointer}
.spot .art{transform-box:fill-box;transform-origin:bottom center;transition:transform .12s}
.spot:active .art{transform:scale(.94)}
.tagbg{fill:#fff;stroke:#E0CFAB;stroke-width:2}
.tagtx{font-size:11.5px;font-weight:700;fill:#5B4A2E;text-anchor:middle;dominant-baseline:middle}
.ping{fill:none;stroke:#FFF0B8;stroke-width:3;opacity:0;transform-box:fill-box;transform-origin:center}

/* ambient animation */
@keyframes drift{from{transform:translateX(-90px)}to{transform:translateX(470px)}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes bob2{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-6px) rotate(-3deg)}}
@keyframes sway{0%,100%{transform:rotate(-1.6deg)}50%{transform:rotate(1.6deg)}}
@keyframes puff{0%{transform:translate(0,0) scale(.5);opacity:.75}100%{transform:translate(-16px,-40px) scale(1.5);opacity:0}}
@keyframes wheel{to{transform:rotate(360deg)}}
@keyframes twinkle{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes fly{0%{transform:translate(0,0);opacity:0}
  20%{opacity:1}80%{opacity:1}100%{transform:translate(24px,-30px);opacity:0}}
@keyframes peck{0%,100%{transform:rotate(0)}45%{transform:rotate(16deg)}}
@keyframes walk{0%{transform:translateX(0) scaleX(1)}45%{transform:translateX(52px) scaleX(1)}
  50%{transform:translateX(52px) scaleX(-1)}95%{transform:translateX(0) scaleX(-1)}100%{transform:translateX(0) scaleX(1)}}
@keyframes pingA{0%{opacity:.85;transform:scale(.55)}70%{opacity:0;transform:scale(1.5)}100%{opacity:0}}
@keyframes rain{to{transform:translateY(120px)}}
.cloud{animation:drift linear infinite}
.swayer{transform-box:fill-box;transform-origin:bottom center;animation:sway 4.6s ease-in-out infinite}
.bobber{transform-box:fill-box;animation:bob 3.1s ease-in-out infinite}
.smoke circle{transform-box:fill-box;animation:puff 3.4s ease-out infinite}
.tyre{transform-box:fill-box;transform-origin:center;animation:wheel 3.2s linear infinite}
.star{animation:twinkle 3s ease-in-out infinite}
.ffdot{transform-box:fill-box;animation:fly 4.2s ease-in-out infinite}
.hen{transform-box:fill-box;transform-origin:bottom center;animation:peck 2.4s ease-in-out infinite}
.mascot{transform-box:fill-box;animation:walk 13s ease-in-out infinite}
.mascot .body{transform-box:fill-box;animation:bob 1.1s ease-in-out infinite}
.rainline{animation:rain .7s linear infinite}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}

/* ============ HUD ============ */
.hud{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));left:10px;right:10px;
  display:flex;gap:7px;align-items:center;z-index:20;pointer-events:none}
.chipHud{background:rgba(255,253,244,.94);border:2.5px solid #E3A63F;border-radius:999px;
  padding:4px 11px 4px 6px;display:flex;align-items:center;gap:5px;font-size:13px;font-weight:700;
  box-shadow:0 3px 0 rgba(160,110,40,.35)}
.chipHud .e{font-size:15px}
.chipHud.coin{border-color:#E3A63F}
.wx{margin-left:auto;background:rgba(255,253,244,.9);border:2.5px solid #E3A63F;border-radius:999px;
  width:36px;height:36px;display:grid;place-items:center;font-size:18px;box-shadow:0 3px 0 rgba(160,110,40,.35)}
.lvbar{position:absolute;left:0;right:0;bottom:-6px;height:4px;background:#F0E4CB;border-radius:9px;overflow:hidden}
.lvbar i{display:block;height:100%;background:linear-gradient(90deg,#FFD166,#FF9E3D)}

/* ============ nav ============ */
.nav{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(10px + var(--safeB));
  display:flex;align-items:center;gap:2px;background:rgba(255,253,244,.96);border:3px solid #E0CFAB;
  border-radius:999px;padding:5px 7px;z-index:30;box-shadow:0 5px 0 rgba(120,85,40,.28);max-width:96vw}
.nav button{flex:0 0 auto;background:none;border-radius:999px;padding:8px 11px;font-size:11.5px;
  font-weight:700;color:#A2937A;display:inline-flex;align-items:center;justify-content:center;gap:5px;
  line-height:1;white-space:nowrap}
.nav button .e{font-size:15px;line-height:1;display:block;filter:grayscale(.85);opacity:.55}
.nav button .t{line-height:1;display:block;transform:translateY(.5px)}
.nav button.on{background:var(--primary);color:#fff;box-shadow:0 3px 0 #D9932E}
.nav button.on .e{filter:none;opacity:1}
.nav .scanBtn{width:56px;height:56px;border-radius:50%;padding:0;margin:-17px 5px 0;flex:0 0 56px;
  display:grid;place-items:center;background:linear-gradient(180deg,#FFC366,#FFA92E);
  box-shadow:0 5px 0 #D9832A,0 0 0 4px rgba(255,253,244,.96)}
.nav .scanBtn .si{font-size:24px;line-height:1;display:block;transform:translateY(1px)}
.nav .scanBtn:active{transform:translateY(3px);box-shadow:0 2px 0 #D9832A,0 0 0 4px rgba(255,253,244,.96)}
@media (max-width:389px){
  .nav button{padding:9px 10px;gap:0}
  .nav button .t{display:none}
  .nav button .e{font-size:19px;opacity:.7}
  .nav .scanBtn{margin:-17px 3px 0}
}

/* ============ sheets ============ */
.scrim{position:absolute;inset:0;background:rgba(35,25,12,.55);opacity:0;pointer-events:none;
  transition:opacity .25s;z-index:40}
.scrim.on{opacity:1;pointer-events:auto}
.sheet{position:absolute;left:0;right:0;bottom:0;z-index:45;background:var(--bg);
  border-radius:30px 30px 0 0;border-top:5px solid #fff;max-height:86%;display:flex;flex-direction:column;
  transform:translateY(102%);transition:transform .34s cubic-bezier(.2,.9,.25,1);
  box-shadow:0 -10px 30px rgba(0,0,0,.25)}
.sheet.on{transform:translateY(0)}
.sheetHead{padding:12px 18px 8px;position:relative;flex:none}
.grip{width:44px;height:5px;border-radius:9px;background:#E0CFAB;margin:0 auto 10px}
.sheetHead h2{margin:0;font-size:19px;display:flex;align-items:center;gap:8px}
.sheetBody{padding:4px 16px calc(26px + var(--safeB));overflow:auto;-webkit-overflow-scrolling:touch}
.x{position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:50%;background:#fff;
  border:2.5px solid var(--line);font-size:16px;color:#8A7A5A;display:grid;place-items:center}

/* ============ game UI bits ============ */
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{border-radius:20px;padding:12px 13px;border:3px solid #fff;box-shadow:0 4px 0 rgba(0,0,0,.08)}
.tile .lab{font-size:11.5px;font-weight:700;opacity:.8}
.tile .val{font-size:23px;font-weight:700;line-height:1.25;letter-spacing:-.5px}
.tile.gold{background:linear-gradient(180deg,#FFE6A8,#FFD066);color:#7A5210}
.tile.fire{background:linear-gradient(180deg,#FFC7A3,#FF9E6B);color:#7A3610}
.tile.spend{background:linear-gradient(180deg,#FFC3CE,#FF9DB1);color:#7A1E33}
.tile.heart{background:linear-gradient(180deg,#CDEFC4,#9BDE8C);color:#2C5C25}
.tile.wide{grid-column:1/-1}
.sign{background:linear-gradient(180deg,#D89A67,#BE7C4A);border:4px solid #A66B41;border-radius:18px;
  color:#FFF6E4;padding:11px 14px;font-weight:700;text-align:center;box-shadow:0 5px 0 var(--woodD)}
.plank{background:linear-gradient(180deg,#FFF6E2,#FFEDD0);border:3px solid #EBD6AC;border-radius:18px;
  padding:13px 15px;margin-bottom:12px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;
  border-bottom:2px dashed var(--line);font-size:14px}
.row:last-child{border-bottom:0}
.row b{font-family:'Fredoka';font-weight:600}
.pos{color:#3E9B4F}.neg{color:#E0555B}
.note{font-size:11.5px;color:#9A8A6A;line-height:1.55}
.bar{height:15px;background:#F0E4CB;border-radius:999px;overflow:hidden;border:2px solid #E3D3B0}
.bar>i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#A8E063,#6BBE5E);
  transition:width .7s cubic-bezier(.2,.8,.2,1)}
.bar.pinkbar>i{background:linear-gradient(90deg,#FF8FAB,#FF6B8B)}
.btn{display:block;width:100%;border-radius:20px;padding:15px;font-size:17px;font-weight:700;color:#fff;
  background:var(--green);box-shadow:0 5px 0 #57A24C;transition:transform .08s,box-shadow .08s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 #57A24C}
.btn.scan{background:linear-gradient(180deg,#FFC366,#FFA92E);box-shadow:0 5px 0 #D9832A}
.btn.scan:active{box-shadow:0 1px 0 #D9832A}
.btn.ghost{background:#fff;color:var(--text);box-shadow:0 4px 0 var(--line)}
.btn.ghost:active{box-shadow:0 1px 0 var(--line)}
.btn.sm{padding:11px;font-size:14px;border-radius:15px}
.btn2{display:flex;gap:10px}
label.f{display:block;font-size:12.5px;font-weight:700;color:#8A7A5A;margin:12px 0 5px}
input,select{width:100%;font-family:'Fredoka','Mali',sans-serif;font-size:16px;font-weight:700;
  padding:12px 14px;border:3px solid var(--line);border-radius:15px;background:#FFFDF7;color:var(--text);
  outline:none;min-height:48px}
input:focus,select:focus{border-color:var(--primary);background:#fff}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ot{display:flex;align-items:center;gap:9px;background:#FFFDF7;border:3px solid var(--line);
  border-radius:18px;padding:9px 11px;margin-bottom:9px}
.ot .ico{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;font-size:18px;flex:none}
.ot .mid{flex:1;min-width:0}.ot .nm{font-size:13px;font-weight:700;line-height:1.25}
.ot .rate{font-size:10.5px;color:#9A8A6A}
.ot input{width:74px;text-align:center;padding:9px 3px;flex:none;min-height:44px}
.ot .amt{width:70px;text-align:right;font-family:'Fredoka';font-weight:600;font-size:13.5px;flex:none}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
.chip{border:3px solid var(--line);background:#fff;border-radius:999px;padding:7px 13px;font-size:13px;font-weight:700}
.chip.on{background:var(--primary);border-color:#E3A63F;color:#fff}
.exp{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:2px dashed var(--line)}
.exp .ic{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;font-size:18px;background:#FFF3D9}
.warnbox{background:#FFF3D6;border:3px solid #F0D191;border-radius:16px;padding:11px 13px;font-size:12px;line-height:1.55}

/* year view */
.yearHead{display:flex;align-items:center;gap:10px;justify-content:center;margin-bottom:12px}
.yearHead button{width:40px;height:40px;border-radius:14px;background:#fff;border:3px solid var(--line);
  font-size:16px;box-shadow:0 3px 0 var(--line)}
.yearHead .y{font-family:'Fredoka';font-size:27px;font-weight:700;min-width:104px;text-align:center}
.plots{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.plot{background:linear-gradient(180deg,#EFD9B0,#DFC38E);border:3px solid #C9A971;border-radius:16px;
  padding:8px 6px 9px;text-align:center;box-shadow:0 4px 0 #B8945F;position:relative;overflow:hidden}
.plot.empty{background:linear-gradient(180deg,#EDE3CE,#DED2B7);border-color:#CFC0A0;box-shadow:0 4px 0 #BFB094}
.plot.cur{border-color:#FFB84D;box-shadow:0 4px 0 #D9932E}
.plot .mo{font-size:11px;font-weight:700;color:#7A5F35;letter-spacing:.5px}
.plot .pl{font-size:26px;line-height:1.25}
.plot .rm{font-family:'Fredoka';font-size:12px;font-weight:600;color:#4B3A1C}
.plot .dot{position:absolute;top:5px;right:6px;font-size:9px}
.badges{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:4px}
.badge{background:#fff;border:3px solid var(--line);border-radius:16px;padding:9px 10px;display:flex;gap:9px;align-items:center}
.badge .bi{font-size:21px}
.badge .bt{font-size:10.5px;color:#9A8A6A;font-weight:700;line-height:1.2}
.badge .bv{font-size:13px;font-weight:700;font-family:'Fredoka'}
.cmp{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;padding:9px 0;
  border-bottom:2px dashed var(--line)}
.cmp .side{text-align:center}
.cmp .side .k{font-size:10px;color:#9A8A6A;font-weight:700}
.cmp .side .v{font-family:'Fredoka';font-size:14px;font-weight:600}
.cmp .arw{font-size:12px;font-weight:700;font-family:'Fredoka'}
.yTree{display:grid;place-items:center;padding:6px 0 2px}

/* ---------- การ์ดกรอก OT ---------- */
@keyframes cardIn{from{opacity:0;transform:translateY(16px) scale(.96)}to{opacity:1;transform:none}}
@keyframes pop{0%{transform:scale(1)}38%{transform:scale(1.02)}100%{transform:scale(1)}}
@keyframes bump{0%{transform:scale(1)}35%{transform:scale(1.22)}100%{transform:scale(1)}}
@keyframes wig{0%,88%,100%{transform:rotate(0)}92%{transform:rotate(-11deg)}96%{transform:rotate(11deg)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px)}
  40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
@keyframes glowRing{0%{box-shadow:0 0 0 0 rgba(255,184,77,.55)}100%{box-shadow:0 0 0 16px rgba(255,184,77,0)}}
@keyframes spark{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.3)}}
@keyframes totalGlow{0%,100%{text-shadow:none}50%{text-shadow:0 0 18px rgba(255,246,228,.9)}}

.otc{background:#FFFDF7;border:3px solid var(--line);border-radius:20px;padding:12px 13px 13px;
  margin-bottom:11px;animation:cardIn .4s cubic-bezier(.2,.9,.3,1) backwards;
  transition:border-color .25s,background .25s}
.otc.on{border-color:var(--primary);background:linear-gradient(180deg,#FFFBF0,#FFF6E2)}
.otc.pop{animation:pop .34s ease-out}
.otc.ring{animation:glowRing .6s ease-out}
.otc .top{display:flex;align-items:center;gap:9px;margin-bottom:11px}
.otc .ic{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;font-size:20px;
  flex:none;transform-origin:50% 80%}
.otc.on .ic{animation:wig 3.2s ease-in-out infinite}
.otc .nm{font-size:14px;font-weight:700;line-height:1.25}
.otc .sub{font-size:11px;color:#9A8A6A}
.otc .money{flex:none;font-family:'Fredoka';font-weight:700;font-size:16px;color:#9A8A6A;transition:color .3s}
.otc.on .money{color:#3E9B4F}
.otc .money.bump{animation:bump .42s cubic-bezier(.3,1.4,.5,1)}

.tin{display:flex;align-items:center;gap:9px}
.unit{display:flex;align-items:center;gap:7px;background:#fff;border:3px solid var(--line);
  border-radius:16px;padding:4px 12px 4px 6px;transition:border-color .2s,box-shadow .2s}
.unit:focus-within{border-color:var(--primary);box-shadow:0 0 0 4px rgba(255,184,77,.18)}
.unit.bad{animation:shake .35s;border-color:#E0555B}
.unit input{width:54px;border:0;background:none;font-size:25px;font-weight:700;text-align:center;
  padding:8px 0;min-height:0;border-radius:10px}
.unit input:focus{background:#FFF6E2}
.unit .u{font-size:12px;font-weight:700;color:#9A8A6A;white-space:nowrap}
.tin .wipe{margin-left:auto;width:42px;height:42px;border-radius:14px;background:#fff;
  border:3px solid var(--line);font-size:15px;color:#B3A88F;flex:none}
.tin .wipe:active{transform:scale(.9)}

.mlab{font-size:10.5px;font-weight:700;color:#9A8A6A;margin:11px 0 5px}
.mchips{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.mchips button{padding:13px 0;font-size:17px;font-family:'Fredoka';font-weight:700;border-radius:15px;
  border:3px solid var(--line);background:#fff;color:#8A7A5A;box-shadow:0 4px 0 var(--line);
  transition:transform .09s,box-shadow .09s,background .2s,color .2s}
.mchips button:active{transform:translateY(4px);box-shadow:0 0 0 var(--line)}
.mchips button.on{background:linear-gradient(180deg,#FFC366,#FFA92E);color:#fff;
  border-color:#E3A63F;box-shadow:0 4px 0 #D9832A}
.sp{position:fixed;width:9px;height:9px;border-radius:50%;pointer-events:none;z-index:320;
  animation:spark .7s ease-out forwards}

.otProg{display:flex;align-items:center;gap:10px;margin-bottom:13px}
.otProg .bar{flex:1}
.otProg .cnt{font-family:'Fredoka';font-weight:700;font-size:13px;color:#9A8A6A;white-space:nowrap}
.bigtotal{font-size:32px;font-family:'Fredoka';font-weight:700;line-height:1.2}
.bigtotal.glow{animation:totalGlow .8s ease-out}

/* fx */
.coin{position:fixed;width:28px;height:28px;border-radius:50%;z-index:300;pointer-events:none;
  background:radial-gradient(circle at 34% 30%,#FFE9A8,#FFC93C 60%,#E0A21B);border:2px solid #C98A18;
  display:grid;place-items:center;font-size:13px;color:#8A5A17;font-weight:700}
.conf-p{position:fixed;width:9px;height:14px;z-index:300;pointer-events:none;border-radius:2px}
.toast{position:absolute;left:50%;top:calc(58px + env(safe-area-inset-top,0px));transform:translateX(-50%);
  z-index:310;background:rgba(50,40,25,.95);color:#fff;padding:9px 17px;border-radius:999px;font-size:13.5px;
  font-weight:700;opacity:0;transition:opacity .25s;pointer-events:none;max-width:88%;text-align:center}
.toast.on{opacity:1}
</style>
</head>
<body>
<div class="app t-day" id="app">
<svg id="farmSvg" viewBox="0 0 400 720" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--sky1)"/><stop offset="1" stop-color="var(--sky2)"/></linearGradient>
    <linearGradient id="grd" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--g1)"/><stop offset="1" stop-color="var(--g3)"/></linearGradient>
    <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8ED9F5"/><stop offset="1" stop-color="#4FB4DC"/></linearGradient>
    <radialGradient id="glow"><stop offset="0" stop-color="var(--sun)" stop-opacity=".9"/>
      <stop offset="1" stop-color="var(--sun)" stop-opacity="0"/></radialGradient>
    <linearGradient id="wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D89A67"/><stop offset="1" stop-color="#B87748"/></linearGradient>
  </defs>

  <!-- sky -->
  <rect width="400" height="720" fill="url(#sky)"/>
  <g class="stars">
    <circle class="star" cx="46" cy="70" r="1.9" fill="#fff"/><circle class="star" cx="112" cy="42" r="1.5" fill="#fff" style="animation-delay:.6s"/>
    <circle class="star" cx="188" cy="86" r="2.1" fill="#fff" style="animation-delay:1.2s"/><circle class="star" cx="248" cy="38" r="1.4" fill="#fff" style="animation-delay:.3s"/>
    <circle class="star" cx="352" cy="150" r="1.7" fill="#fff" style="animation-delay:1.7s"/><circle class="star" cx="76" cy="168" r="1.5" fill="#fff" style="animation-delay:.9s"/>
    <circle class="star" cx="300" cy="102" r="1.3" fill="#fff" style="animation-delay:2.1s"/><circle class="star" cx="150" cy="150" r="1.6" fill="#fff" style="animation-delay:1.5s"/>
  </g>
  <g id="sunmoon"><circle cx="318" cy="84" r="46" fill="url(#glow)"/><circle id="orb" cx="318" cy="84" r="25" fill="var(--sun)"/>
    <circle id="moonBite" cx="330" cy="74" r="20" fill="var(--sky1)" opacity="0"/></g>
  <g fill="#fff" opacity=".85">
    <g class="cloud" style="animation-duration:52s"><ellipse cx="60" cy="96" rx="32" ry="14"/><ellipse cx="86" cy="88" rx="22" ry="13"/><ellipse cx="38" cy="90" rx="18" ry="10"/></g>
    <g class="cloud" style="animation-duration:74s;animation-delay:-30s" opacity=".75"><ellipse cx="200" cy="150" rx="26" ry="11"/><ellipse cx="220" cy="144" rx="18" ry="10"/></g>
    <g class="cloud" style="animation-duration:96s;animation-delay:-60s" opacity=".6"><ellipse cx="140" cy="58" rx="34" ry="12"/><ellipse cx="166" cy="52" rx="20" ry="11"/></g>
  </g>

  <!-- far hills -->
  <path d="M0 316 Q64 268 138 306 Q210 340 268 296 Q330 254 400 302 V720 H0Z" fill="var(--g1)" opacity=".75"/>
  <path d="M0 344 Q90 306 176 340 Q262 374 332 336 Q368 318 400 330 V720 H0Z" fill="url(#grd)"/>
  <!-- field stripes -->
  <g opacity=".16" fill="#2E5237">
    <path d="M0 420 Q200 396 400 414 V436 Q200 418 0 442Z"/>
    <path d="M0 520 Q200 500 400 512 V532 Q200 520 0 542Z"/>
  </g>
  <!-- path -->
  <path d="M232 720 C238 660 176 626 190 566 C202 514 268 490 268 440 C268 412 260 402 258 392"
        stroke="#E8D3A6" stroke-width="26" fill="none" stroke-linecap="round"/>
  <path d="M232 720 C238 660 176 626 190 566 C202 514 268 490 268 440 C268 412 260 402 258 392"
        stroke="#F5E6C2" stroke-width="18" fill="none" stroke-linecap="round"/>

  <!-- pond -->
  <g class="bobber" style="animation-duration:5s">
    <ellipse cx="58" cy="694" rx="56" ry="24" fill="#69B04E" opacity=".5"/>
    <ellipse cx="58" cy="692" rx="48" ry="19" fill="url(#water)"/>
    <path d="M30 688 q10 -4 20 0 M46 698 q12 -4 24 0" stroke="#DFF6FF" stroke-width="2.4" fill="none" opacity=".8"/>
  </g>
  <!-- rocks & flowers -->
  <g>
    <ellipse cx="356" cy="418" rx="15" ry="9" fill="#B9B2A2"/><ellipse cx="350" cy="414" rx="9" ry="6" fill="#CFC8B8"/>
    <ellipse cx="26" cy="470" rx="12" ry="7" fill="#B9B2A2"/>
    <g fill="#FF8FAB"><circle cx="150" cy="428" r="4"/><circle cx="162" cy="436" r="3.4"/><circle cx="330" cy="596" r="4"/><circle cx="342" cy="604" r="3.4"/><circle cx="18" cy="546" r="3.6"/></g>
    <g fill="#FFD166"><circle cx="158" cy="424" r="3.2"/><circle cx="338" cy="590" r="3.2"/><circle cx="118" cy="700" r="3.4"/></g>
  </g>
  <!-- back trees -->
  <g class="swayer" style="animation-duration:5.4s">
    <rect x="366" y="352" width="8" height="26" rx="3" fill="#8B5E3C"/>
    <circle cx="370" cy="342" r="20" fill="#57A84B"/><circle cx="358" cy="350" r="14" fill="#6BBE5E"/></g>
  <g class="swayer" style="animation-duration:6.2s;animation-delay:-2s">
    <rect x="150" y="366" width="7" height="22" rx="3" fill="#8B5E3C"/>
    <circle cx="153" cy="358" r="17" fill="#6BBE5E"/><circle cx="164" cy="364" r="11" fill="#57A84B"/></g>
  <!-- fence -->
  <g stroke="#DCB98A" stroke-width="5" stroke-linecap="round" opacity=".95">
    <path d="M8 612 v26 M40 616 v26 M72 620 v26"/><path d="M4 620 h72 M4 632 h72"/>
    <path d="M300 448 v24 M330 446 v24 M360 444 v24"/><path d="M296 454 h68 M296 464 h68"/>
  </g>

  <!-- night veil -->
  <rect class="veil" width="400" height="720" fill="#16204A" style="opacity:var(--veil)"/>
  <g id="wx"></g>

  <!-- ============ SPOTS ============ -->
  <!-- YEAR TREE -->
  <g class="spot" data-open="year">
    <rect class="hit" pointer-events="all" x="6" y="248" width="120" height="130" fill="transparent"/>
    <g class="art"><g class="swayer" style="animation-duration:5.8s">
      <ellipse cx="62" cy="374" rx="40" ry="9" fill="#2E5237" opacity=".22"/>
      <path d="M56 374 q-2 -30 6 -46 l10 2 q-8 18 -4 44Z" fill="#8B5E3C"/>
      <circle cx="62" cy="308" r="34" fill="#57A84B"/><circle cx="36" cy="322" r="22" fill="#6BBE5E"/>
      <circle cx="88" cy="320" r="24" fill="#6BBE5E"/><circle cx="62" cy="292" r="24" fill="#7DD06A"/>
      <circle cx="46" cy="300" r="5" fill="#FF8FAB"/><circle cx="80" cy="306" r="4.4" fill="#FFD166"/>
      <circle cx="66" cy="330" r="4.6" fill="#FF8FAB"/>
    </g></g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="62" cy="316" r="40"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="18" y="248" width="88" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="62" y="261">🌳 สรุปรายปี</text></g>
  </g>

  <!-- HOUSE -->
  <g class="spot" data-open="house">
    <rect class="hit" pointer-events="all" x="196" y="300" width="140" height="112" fill="transparent"/>
    <g class="art">
      <ellipse cx="264" cy="404" rx="58" ry="11" fill="#2E5237" opacity=".22"/>
      <rect x="292" y="330" width="15" height="30" rx="4" fill="#C4514C"/>
      <g class="smoke" fill="#fff" opacity=".8">
        <circle cx="300" cy="330" r="6"/><circle cx="300" cy="330" r="5" style="animation-delay:1.1s"/>
        <circle cx="300" cy="330" r="6.5" style="animation-delay:2.2s"/></g>
      <rect x="214" y="352" width="100" height="52" rx="7" fill="#FFF0D6"/>
      <rect x="214" y="352" width="100" height="52" rx="7" fill="none" stroke="#E8CFA4" stroke-width="2"/>
      <path d="M204 356 L264 314 L324 356Z" fill="#E06A63"/>
      <path d="M204 356 L264 314 L324 356Z" fill="none" stroke="#C4514C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M264 314 L264 356" stroke="#C4514C" stroke-width="2.5"/>
      <rect x="252" y="372" width="24" height="32" rx="5" fill="#B87748"/>
      <circle cx="271" cy="389" r="2.4" fill="#FFD166"/>
      <rect x="224" y="366" width="20" height="18" rx="4" fill="#9FD8F0" stroke="#E8CFA4" stroke-width="2.5"/>
      <rect x="286" y="366" width="20" height="18" rx="4" fill="#9FD8F0" stroke="#E8CFA4" stroke-width="2.5"/>
      <g class="win"><rect x="224" y="366" width="20" height="18" rx="4" fill="#FFD86B"/>
        <rect x="286" y="366" width="20" height="18" rx="4" fill="#FFD86B"/>
        <ellipse cx="264" cy="410" rx="70" ry="20" fill="#FFD86B" opacity=".18"/></g>
      <rect x="220" y="396" width="30" height="9" rx="4" fill="#7BC96F"/>
      <circle cx="227" cy="396" r="3.4" fill="#FF8FAB"/><circle cx="237" cy="395" r="3.4" fill="#FFD166"/>
      <circle cx="246" cy="396" r="3.2" fill="#FF8FAB"/>
    </g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="264" cy="360" r="46"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="218" y="292" width="92" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="264" y="305">🏡 บ้านของฉัน</text></g>
  </g>

  <!-- MONEY BARN -->
  <g class="spot" data-open="barn">
    <rect class="hit" pointer-events="all" x="42" y="398" width="120" height="98" fill="transparent"/>
    <g class="art">
      <ellipse cx="102" cy="482" rx="46" ry="9" fill="#2E5237" opacity=".22"/>
      <rect x="62" y="440" width="80" height="44" rx="6" fill="#E06A63"/>
      <path d="M54 442 L102 414 L150 442Z" fill="#C4514C"/>
      <rect x="62" y="440" width="80" height="6" fill="#FFF0D6" opacity=".55"/>
      <rect x="84" y="454" width="36" height="30" rx="4" fill="#FFF0D6"/>
      <path d="M84 454 L120 484 M120 454 L84 484" stroke="#C4514C" stroke-width="3.4"/>
      <circle cx="102" cy="430" r="8" fill="#FFD166" stroke="#D9A21B" stroke-width="2"/>
      <text x="102" y="434" font-size="9" text-anchor="middle" fill="#8A5A17" font-weight="700">฿</text>
      <g class="win"><rect x="84" y="454" width="36" height="30" rx="4" fill="#FFD86B" opacity=".9"/></g>
    </g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="102" cy="450" r="42"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="56" y="392" width="92" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="102" y="405">🪙 ยุ้งเก็บเงิน</text></g>
  </g>

  <!-- ORDER BOARD -->
  <g class="spot" data-open="board">
    <rect class="hit" pointer-events="all" x="158" y="486" width="96" height="86" fill="transparent"/>
    <g class="art">
      <ellipse cx="206" cy="562" rx="30" ry="7" fill="#2E5237" opacity=".2"/>
      <rect x="182" y="530" width="7" height="32" rx="3" fill="#A66B41"/>
      <rect x="223" y="530" width="7" height="32" rx="3" fill="#A66B41"/>
      <rect x="172" y="500" width="68" height="38" rx="7" fill="url(#wood)" stroke="#A66B41" stroke-width="3"/>
      <rect x="180" y="508" width="22" height="16" rx="3" fill="#FFF6E4"/>
      <rect x="208" y="508" width="24" height="12" rx="3" fill="#FFF0D6"/>
      <rect x="180" y="527" width="34" height="6" rx="3" fill="#FFF6E4" opacity=".8"/>
      <circle cx="191" cy="506" r="2.6" fill="#E0555B"/><circle cx="220" cy="506" r="2.6" fill="#E0555B"/>
    </g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="206" cy="520" r="36"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="164" y="478" width="84" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="206" y="491">📋 เป้าหมาย</text></g>
  </g>

  <!-- MARKET -->
  <g class="spot" data-open="market">
    <rect class="hit" pointer-events="all" x="272" y="474" width="122" height="98" fill="transparent"/>
    <g class="art">
      <ellipse cx="332" cy="562" rx="44" ry="9" fill="#2E5237" opacity=".22"/>
      <rect x="296" y="518" width="72" height="42" rx="6" fill="#FFF0D6" stroke="#E8CFA4" stroke-width="2.5"/>
      <rect x="292" y="508" width="80" height="12" rx="5" fill="#B87748"/>
