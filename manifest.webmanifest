      <circle cx="340" cy="528" r="4.4" fill="#7BC96F"/><circle cx="350" cy="527" r="4" fill="#FF8FAB"/>
      <g class="win"><rect x="296" y="518" width="72" height="42" rx="6" fill="#FFD86B" opacity=".55"/></g>
    </g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="332" cy="524" r="42"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="290" y="468" width="84" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="332" y="481">🛒 ตลาด</text></g>
  </g>

  <!-- SAVING GARDEN -->
  <g class="spot" data-open="garden">
    <rect class="hit" pointer-events="all" x="6" y="524" width="132" height="86" fill="transparent"/>
    <g class="art">
      <rect x="16" y="556" width="112" height="44" rx="10" fill="#B98A56"/>
      <rect x="16" y="556" width="112" height="44" rx="10" fill="none" stroke="#96683B" stroke-width="3"/>
      <path d="M22 570 h100 M22 584 h100" stroke="#96683B" stroke-width="2.5" opacity=".6"/>
      <g id="gardenPlants"></g>
    </g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="72" cy="576" r="40"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="26" y="518" width="92" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="72" y="531">🌱 สวนเงินเก็บ</text></g>
  </g>

  <!-- CHICKEN COOP -->
  <g>
    <ellipse cx="176" cy="632" rx="34" ry="8" fill="#2E5237" opacity=".2"/>
    <rect x="152" y="602" width="46" height="28" rx="5" fill="#FFE0B0" stroke="#D9A76A" stroke-width="2.5"/>
    <path d="M146 604 L175 586 L204 604Z" fill="#E8A15C"/>
    <circle cx="175" cy="618" r="7" fill="#8B5E3C"/>
    <g class="hen" style="animation-delay:.4s"><ellipse cx="212" cy="636" rx="9" ry="7.5" fill="#fff"/>
      <circle cx="219" cy="629" r="4.6" fill="#fff"/><circle cx="221" cy="628" r="1.1" fill="#3D3D3D"/>
      <path d="M223 630 l4 2 -4 2Z" fill="#FFB84D"/><path d="M218 624 q2 -4 4 0Z" fill="#E0555B"/>
      <path d="M209 643 v3 M215 643 v3" stroke="#FFB84D" stroke-width="1.8"/></g>
    <g class="hen" style="animation-delay:1.5s"><ellipse cx="140" cy="642" rx="8" ry="6.6" fill="#FFF0D6"/>
      <circle cx="134" cy="636" r="4.2" fill="#FFF0D6"/><circle cx="132" cy="635" r="1" fill="#3D3D3D"/>
      <path d="M130 637 l-4 2 4 2Z" fill="#FFB84D"/></g>
  </g>
  <!-- COW -->
  <g class="bobber" style="animation-duration:4.4s">
    <ellipse cx="98" cy="668" rx="26" ry="7" fill="#2E5237" opacity=".2"/>
    <ellipse cx="98" cy="652" rx="24" ry="15" fill="#FFFDF7"/>
    <ellipse cx="88" cy="648" rx="7" ry="5" fill="#5A5750"/><ellipse cx="106" cy="657" rx="5.5" ry="4" fill="#5A5750"/>
    <circle cx="124" cy="646" r="10" fill="#FFFDF7"/><circle cx="127" cy="644" r="1.5" fill="#3D3D3D"/>
    <ellipse cx="130" cy="650" rx="6" ry="4.5" fill="#FFC9D4"/>
    <path d="M116 638 q-3 -6 3 -5" stroke="#5A5750" stroke-width="2.4" fill="none"/>
    <path d="M84 664 v6 M96 665 v6 M108 664 v6" stroke="#5A5750" stroke-width="3.4" stroke-linecap="round"/>
  </g>

  <!-- OT TRUCK -->
  <g class="spot" data-open="ot" transform="translate(-6,-62)">
    <rect class="hit" pointer-events="all" x="216" y="612" width="152" height="104" fill="transparent"/>
    <g class="art"><g class="bobber" style="animation-duration:1.9s">
      <ellipse cx="292" cy="700" rx="56" ry="10" fill="#2E5237" opacity=".22"/>
      <g class="smoke" fill="#D9D2C4" opacity=".75">
        <circle cx="240" cy="682" r="5"/><circle cx="240" cy="682" r="4" style="animation-delay:1.4s"/></g>
      <rect x="248" y="650" width="52" height="34" rx="6" fill="#F0B45B" stroke="#D9932E" stroke-width="2.5"/>
      <rect x="254" y="656" width="40" height="9" rx="3" fill="#FFF6E4"/>
      <text x="274" y="678" font-size="11" text-anchor="middle" fill="#8A5A17" font-weight="700">OT</text>
      <path d="M300 662 h34 l14 16 v14 h-48Z" fill="#FFD166" stroke="#D9A21B" stroke-width="2.5" stroke-linejoin="round"/>
      <rect x="306" y="666" width="20" height="13" rx="3" fill="#9FD8F0" stroke="#D9A21B" stroke-width="2"/>
      <rect x="244" y="684" width="108" height="8" rx="4" fill="#B87748"/>
      <g class="win"><circle cx="350" cy="682" r="4.6" fill="#FFF3C4"/>
        <path d="M354 682 l24 -10 v20Z" fill="#FFF3C4" opacity=".38"/></g>
      <g class="tyre" style="transform-origin:266px 694px"><circle cx="266" cy="694" r="12" fill="#4A4A4A"/>
        <circle cx="266" cy="694" r="5" fill="#CFC8B8"/><path d="M266 684 v20 M256 694 h20" stroke="#8C8C8C" stroke-width="2"/></g>
      <g class="tyre" style="transform-origin:330px 694px;animation-delay:-1s"><circle cx="330" cy="694" r="12" fill="#4A4A4A"/>
        <circle cx="330" cy="694" r="5" fill="#CFC8B8"/><path d="M330 684 v20 M320 694 h20" stroke="#8C8C8C" stroke-width="2"/></g>
    </g></g>
    <circle class="ping" fill="none" stroke="#FFF0B8" cx="296" cy="672" r="50"/>
    <g><rect class="tagbg" fill="#ffffff" stroke="#E0CFAB" stroke-width="2" x="240" y="620" width="104" height="24" rx="12"/>
      <text class="tagtx" fill="#5B4A2E" font-size="11.5" text-anchor="middle" font-weight="700" x="292" y="633">🚜 OT DELIVERY</text></g>
  </g>

  <!-- MASCOT -->
  <g transform="translate(46,-58)"><g class="mascot"><g class="body">
    <ellipse cx="180" cy="700" rx="16" ry="4" fill="#2E5237" opacity=".2"/>
    <path d="M166 676 L163 662 L176 670Z" fill="#F3A76B"/><path d="M194 676 L197 662 L184 670Z" fill="#F3A76B"/>
    <circle cx="180" cy="684" r="17" fill="#FFC48C"/>
    <circle cx="174" cy="681" r="2.6" fill="#3D3D3D"/><circle cx="187" cy="681" r="2.6" fill="#3D3D3D"/>
    <ellipse cx="180" cy="689" rx="6.5" ry="5" fill="#FFF1DC"/>
    <circle cx="180" cy="687" r="1.9" fill="#3D3D3D"/>
    <path d="M177 691 q3 3 6 0" stroke="#3D3D3D" stroke-width="1.4" fill="none" stroke-linecap="round"/>
    <circle cx="167" cy="688" r="2.8" fill="#FF8FAB" opacity=".5"/><circle cx="193" cy="688" r="2.8" fill="#FF8FAB" opacity=".5"/>
  </g></g></g>

  <!-- fireflies -->
  <g class="ff" fill="#FFF3A0">
    <circle class="ffdot" cx="120" cy="520" r="2.6"/><circle class="ffdot" cx="230" cy="600" r="2.2" style="animation-delay:1.4s"/>
    <circle class="ffdot" cx="60" cy="640" r="2.4" style="animation-delay:2.6s"/><circle class="ffdot" cx="320" cy="600" r="2.2" style="animation-delay:3.4s"/>
    <circle class="ffdot" cx="180" cy="470" r="2.4" style="animation-delay:.7s"/><circle class="ffdot" cx="300" cy="430" r="2.2" style="animation-delay:2.1s"/>
  </g>
</svg>

<!-- ============ HUD ============ -->
<div class="hud">
  <div class="chipHud" style="position:relative"><span class="e">⭐</span><span class="num" id="hLv">Lv.1</span>
    <div class="lvbar"><i id="hLvBar" style="width:0%"></i></div></div>
  <div class="chipHud coin"><span class="e">🪙</span><span class="num" id="hCoin">฿0</span></div>
  <div class="chipHud"><span class="e">💎</span><span class="num" id="hGem">0</span></div>
  <div class="wx" id="hWx">☀️</div>
</div>

<div class="moneyBoard" id="mBoard">
  <div id="mTap"><div class="lab">🪙 เงินเหลือในฟาร์ม</div><div class="val num" id="mVal">฿0</div></div>
  <button class="eye" id="eyeBtn" aria-label="ซ่อน/แสดงยอดเงิน">👁️</button>
</div>

<!-- ============ NAV ============ -->
<div class="nav">
  <button class="on" data-nav="farm" aria-label="ฟาร์ม"><span class="e">🏡</span><span class="t">ฟาร์ม</span></button>
  <button data-nav="market" aria-label="ตลาด"><span class="e">🛒</span><span class="t">ตลาด</span></button>
  <button class="scanBtn" data-nav="ot" aria-label="กรอก OT"><span class="si">🚜</span></button>
  <button data-nav="year" aria-label="รายปี"><span class="e">📅</span><span class="t">รายปี</span></button>
  <button data-nav="settings" aria-label="ตั้งค่า"><span class="e">⚙️</span><span class="t">ตั้งค่า</span></button>
</div>

<div class="scrim" id="scrim"></div>
<div class="sheet" id="sheet">
  <div class="sheetHead"><div class="grip"></div><h2 id="sheetTitle"></h2><button class="x" id="sheetX">✕</button></div>
  <div class="sheetBody" id="sheetBody"></div>
</div>
<div class="toast" id="toast"></div>
</div>

<script>
/* =====================================================================
   OT CALCULATION ENGINE — ถอดสูตรจาก Cal_OT.xlsx (แยกจาก UI 100%)
   เรตต่อชั่วโมง = (เงินเดือน+ค่าครองชีพ+ค่าตำแหน่ง+ค่าเช่าบ้าน)/30/8 × ตัวคูณ
   ===================================================================== */
const OTEngine={
  buckets:[
    {k:'h1',  col:'1',         mult:1,  pub:false,name:'วันหยุดประจำสัปดาห์ (8 ชม.แรก)',ico:'🌤️',bg:'#DFF3FF'},
    {k:'h15', col:'1.5',       mult:1.5,pub:false,name:'OT วันธรรมดา',                 ico:'🌙',bg:'#FFF0D6'},
    {k:'h3',  col:'3',         mult:3,  pub:false,name:'OT เกินเวลา (วันหยุด)',         ico:'🔥',bg:'#FFE1E6'},
    {k:'h15p',col:'1.5 Public',mult:1.5,pub:true, name:'วันนักขัตฤกษ์ (8 ชม.แรก)',      ico:'🎌',bg:'#EFE7FF'},
    {k:'h2p', col:'2 Public',  mult:2,  pub:true, name:'OT วันนักขัตฤกษ์ ×2',           ico:'🎏',bg:'#E7F7E3'},
    {k:'h3p', col:'3 (นักขัตฤกษ์)',mult:3,pub:true,name:'OT วันนักขัตฤกษ์ ×3',          ico:'🎆',bg:'#FFE9F6'}],
  hourly(s){return (n(s.base)+n(s.col)+n(s.pos)+n(s.house))/30/8},
  hourlyPub(s,st){return st?(n(s.base)+n(s.col)+n(s.pos))/30/8:this.hourly(s)},
  rates(s,st){const bw=this.hourly(s),bp=this.hourlyPub(s,st),r={};
    this.buckets.forEach(b=>r[b.k]=(b.pub?bp:bw)*b.mult);return r},
  otPay(s,h,st){const r=this.rates(s,st);let t=0;const l={};
    this.buckets.forEach(b=>{l[b.k]=(h[b.k]||0)*r[b.k];t+=l[b.k]});return{total:t,lines:l,rates:r}},
  perDayPay(s,d){return n(d.meal)*n(s.mealRate)+n(d.otMeal)*n(s.otMealRate)+n(d.shift)*n(s.shiftRate)},
  summary(s,h,d,st,exp){
    const ot=this.otPay(s,h,st),perDay=this.perDayPay(s,d);
    const salary=n(s.base)+n(s.col)+n(s.pos)+n(s.env)+n(s.house)+n(s.dili)+n(s.bonus);
    const ded=n(s.sso)+n(s.pvd)+n(s.loan);
    const income=salary+perDay+ot.total;
    const spent=exp.reduce((a,e)=>a+e.amount,0);
    return{ot,perDay,salary,ded,income,spent,left:income-ded-spent,noOt:salary+perDay-ded-spent};}
};
/* helpers */
const n=v=>{const x=parseFloat(v);return isNaN(x)?0:x};
const B=v=>'฿'+Math.round(v).toLocaleString('en-US');
const B2=v=>'฿'+v.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const hm=v=>{if(v==null)return 0;v=(''+v).trim();if(!v)return 0;
  if(v.includes(':')){const[a,b]=v.split(':');return n(a)+n(b)/60}return n(v)};
const toHM=h=>{const t=Math.round(h*60);return Math.floor(t/60)+':'+String(t%60).padStart(2,'0')};
const $=id=>document.getElementById(id);
const esc=s=>(''+s).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));

/* =====================================================================
   STATE
   ===================================================================== */
const CATS=[{k:'food',n:'อาหาร',i:'🍜'},{k:'home',n:'บ้าน',i:'🏠'},{k:'move',n:'เดินทาง',i:'🚗'},
 {k:'stuff',n:'ของใช้',i:'🛍'},{k:'fun',n:'ความบันเทิง',i:'🎮'},{k:'debt',n:'หนี้/ผ่อน',i:'💳'},{k:'etc',n:'อื่น ๆ',i:'✨'}];
const KW={food:['ข้าว','กิน','กาแฟ','น้ำ','อาหาร','ก๋วยเตี๋ยว','เซเว่น','7-11','ขนม','หมูกระทะ','ชานม'],
 home:['เช่า','ค่าน้ำ','ค่าไฟ','บ้าน','หอ','เน็ต','แก๊ส'],move:['น้ำมัน','รถ','วิน','แท็กซี่','ทางด่วน','เดินทาง','มอไซค์'],
 stuff:['ของใช้','สบู่','ยาสีฟัน','ซัก','เสื้อ','รองเท้า'],fun:['หนัง','เกม','เที่ยว','เบียร์','คาราโอเกะ'],
 debt:['ผ่อน','หนี้','บัตร','กู้']};
const MO=['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
const MOE=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];

let S={base:18000,col:0,pos:0,house:0,env:0,dili:1200,bonus:0,mealRate:50,otMealRate:35,shiftRate:120,sso:750,pvd:0,loan:0};
let H={h1:0,h15:0,h3:0,h15p:0,h2p:0,h3p:0};
let D={meal:0,otMeal:0,shift:0};
let EXP=[],STRICT=0;
let GOALS=[];
let HIDE=0;
let YEARS={};
let viewYear=new Date().getFullYear();

const KEY='moneyfarm:v2';
/* เก็บข้อมูลไว้ในเครื่อง — ใช้ได้ทั้งบนเว็บจริง (localStorage) และในตัวพรีวิว */
async function save(){const j=JSON.stringify({S,H,D,EXP,STRICT,GOALS,YEARS,HIDE});
  try{if(window.storage&&window.storage.set){await window.storage.set(KEY,j);return}}catch(e){}
  try{localStorage.setItem(KEY,j)}catch(e){}}
async function load(){let raw=null;
  try{if(window.storage&&window.storage.get){const r=await window.storage.get(KEY);raw=r&&r.value}}catch(e){}
  if(!raw){try{raw=localStorage.getItem(KEY)}catch(e){}}
  if(!raw)return;
  try{const d=JSON.parse(raw);
    Object.assign(S,d.S||{});Object.assign(H,d.H||{});Object.assign(D,d.D||{});
    EXP=d.EXP||[];STRICT=d.STRICT||0;GOALS=d.GOALS||[];YEARS=d.YEARS||{};HIDE=d.HIDE||0;
    purgeDemo()}catch(e){}}
/* ล้างข้อมูลตัวอย่างเก่าที่เคยใส่ไว้ให้หมด */
function purgeDemo(){Object.keys(YEARS).forEach(y=>{Object.keys(YEARS[y]).forEach(m=>{if(YEARS[y][m].demo)delete YEARS[y][m]});
  if(!Object.keys(YEARS[y]).length)delete YEARS[y]})}

/* รอบจ่าย 16 → 15 ; เดือนของรอบ = เดือนที่จบรอบ */
function cycle(){const t=new Date(),d=t.getDate();
  const st=new Date(t.getFullYear(),t.getMonth()+(d>=16?0:-1),16);
  const en=new Date(st.getFullYear(),st.getMonth()+1,15);
  return{st,en,y:en.getFullYear(),m:en.getMonth(),
    daysLeft:Math.max(1,Math.ceil((en-t)/864e5)+1),
    label:`16 ${MO[st.getMonth()]} – 15 ${MO[en.getMonth()]}`};}

function commitMonth(sum){const c=cycle();if(!YEARS[c.y])YEARS[c.y]={};
  YEARS[c.y][c.m]={income:Math.round(sum.income),expense:Math.round(sum.spent),
    ot:Math.round(sum.ot.total),ded:Math.round(sum.ded),left:Math.round(sum.left)};}

/* =====================================================================
   FARM ATMOSPHERE
   ===================================================================== */
const WX=['sun','cloud','rain','rainbow'];
let weather=WX[new Date().getDate()%4];
function applyTime(){
  const h=new Date().getHours();
  const t=(h>=6&&h<16)?'day':(h>=16&&h<19)?'eve':'night';
  $('app').className='app t-'+t;
  $('moonBite').setAttribute('opacity',t==='night'?'1':'0');
  $('hWx').textContent={sun:'☀️',cloud:'🌤️',rain:'🌧️',rainbow:'🌈'}[weather];
  const wx=$('wx');let s='';
  if(weather==='rain'){for(let i=0;i<26;i++){const x=Math.random()*400,y=Math.random()*400+180;
    s+=`<line class="rainline" x1="${x}" y1="${y}" x2="${x-5}" y2="${y+14}" stroke="#BFE9FF" stroke-width="2"
      opacity=".55" style="animation-delay:-${(Math.random()*.7).toFixed(2)}s"/>`}}
  if(weather==='rainbow'){s+=`<g opacity=".5" fill="none" stroke-width="9">
    <path d="M-10 340 A210 210 0 0 1 410 340" stroke="#FF8FAB"/><path d="M2 340 A198 198 0 0 1 398 340" stroke="#FFB84D"/>
    <path d="M14 340 A186 186 0 0 1 386 340" stroke="#FFD166"/><path d="M26 340 A174 174 0 0 1 374 340" stroke="#7BC96F"/>
    <path d="M38 340 A162 162 0 0 1 362 340" stroke="#7DD3FC"/></g>`}
  if(weather==='cloud'){s+=`<g fill="#fff" opacity=".55"><ellipse cx="280" cy="120" rx="46" ry="18"/>
    <ellipse cx="312" cy="110" rx="30" ry="16"/></g>`}
  wx.innerHTML=s;
}
function drawGarden(){
  const tot=GOALS.reduce((a,g)=>a+g.s,0),tgt=GOALS.reduce((a,g)=>a+g.t,0)||1;
  const p=Math.min(1,tot/tgt);let s='';
  for(let i=0;i<6;i++){
    const x=30+i*17,y=592,gr=Math.max(0,Math.min(1,p*6-i));
    if(gr<=0){s+=`<ellipse cx="${x}" cy="${y}" rx="5" ry="2.6" fill="#96683B"/>`;continue}
    const hgt=6+gr*20;
    s+=`<path d="M${x} ${y} v${-hgt}" stroke="#4E9040" stroke-width="2.6" stroke-linecap="round"/>`;
    s+=`<path d="M${x} ${y-hgt*.6} q-8 -5 -1 -9 q6 3 1 9Z" fill="#6BBE5E"/>`;
    if(gr>.5)s+=`<path d="M${x} ${y-hgt*.85} q8 -5 1 -9 q-6 3 -1 9Z" fill="#7DD06A"/>`;
    if(gr>.85)s+=`<circle cx="${x}" cy="${y-hgt-3}" r="4.6" fill="#FFD166"/><circle cx="${x}" cy="${y-hgt-3}" r="2" fill="#E08A2B"/>`;
  }
  $('gardenPlants').innerHTML=s;
}

/* =====================================================================
   RENDER (HUD + ฟาร์ม)
   ===================================================================== */
function state(){return OTEngine.summary(S,H,D,STRICT,EXP)}
function render(){
  const sum=state(),c=cycle();
  commitMonth(sum);
  const yearSaved=Object.values(YEARS[c.y]||{}).reduce((a,m)=>a+Math.max(0,m.left),0);
  const lv=Math.max(1,Math.floor(yearSaved/8000)+1),xp=(yearSaved%8000)/8000*100;
  $('hLv').textContent='Lv.'+lv;$('hLvBar').style.width=xp+'%';
  const mask='฿ ••••••';
  $('hCoin').textContent=HIDE?'฿ ••••':B(sum.left);
  $('mVal').textContent=HIDE?mask:B(sum.left);
  $('eyeBtn').textContent=HIDE?'🙈':'👁️';
  $('hGem').textContent=Math.floor(sum.ot.total/500);
  drawGarden();
  if(openKey&&!LIVE.includes(openKey))renderSheet(openKey,true);else liveNums();
}
const LIVE=['ot','settings'];
const rateTblHtml=()=>{const r=OTEngine.rates(S,STRICT);
  return OTEngine.buckets.map(b=>`<div class="row"><span>${b.ico} ${b.col} <span style="color:#B3A88F">(×${b.mult})</span></span>
    <b>${B2(r[b.k])}/ชม.</b></div>`).join('')};
/* อัปเดตเฉพาะตัวเลข ไม่ rebuild ทั้งหน้า จะได้ไม่หลุด focus ตอนพิมพ์ */
function countTo(el,to){
  const from=(el._v===undefined)?to:el._v;el._v=to;
  if(Math.round(from)===Math.round(to)){el.textContent=B(to);return}
  el.classList.remove('bump');void el.offsetWidth;el.classList.add('bump');
  const t0=performance.now();
  const step=t=>{const p=Math.min(1,(t-t0)/450),e=1-Math.pow(1-p,3);
    el.textContent=B(from+(to-from)*e);if(p<1)requestAnimationFrame(step)};
  requestAnimationFrame(step);
}
function sparkle(el){
  const r=el.getBoundingClientRect(),cs=['#FFD166','#FF8FAB','#7BC96F','#7DD3FC','#A78BFA'];
  for(let i=0;i<8;i++){const d=document.createElement('div');d.className='sp';
    d.style.background=cs[i%cs.length];
    d.style.left=(r.left+r.width/2)+'px';d.style.top=(r.top+r.height/2)+'px';
    d.style.setProperty('--dx',((Math.random()-.5)*90).toFixed(0)+'px');
    d.style.setProperty('--dy',(-30-Math.random()*55).toFixed(0)+'px');
    document.body.appendChild(d);setTimeout(()=>d.remove(),760)}
}
function liveNums(){const s=state();
  const tot=$('otTotalSign');
  if(tot){
    OTEngine.buckets.forEach(b=>{const e=$('am-'+b.k);if(e)countTo(e,s.ot.lines[b.k])});
    countTo(tot,s.ot.total);
    tot.classList.remove('glow');void tot.offsetWidth;tot.classList.add('glow');
    const pd=$('perDaySum');if(pd)pd.textContent='+'+B(s.perDay);}
  if($('rateTbl'))$('rateTbl').innerHTML=rateTblHtml();
}
let sv;function saveSoon(){clearTimeout(sv);sv=setTimeout(save,600)}

/* =====================================================================
   SHEETS
   ===================================================================== */
let openKey=null,stack=[];
function openSheet(k){openKey=k;renderSheet(k);$('scrim').classList.add('on');$('sheet').classList.add('on')}
function closeSheet(){openKey=null;stack=[];$('scrim').classList.remove('on');$('sheet').classList.remove('on');
  document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('on',b.dataset.nav==='farm'))}
$('scrim').onclick=closeSheet;$('sheetX').onclick=closeSheet;

function renderSheet(k,keepScroll){
  const b=$('sheetBody'),prev=b.scrollTop;
  const v=VIEWS[k]();$('sheetTitle').innerHTML=v.title;b.innerHTML=v.html;
  if(v.after)v.after();
  bindSwipe();
  if(keepScroll)b.scrollTop=prev;else b.scrollTop=0;
}
const barRow=(lab,val,max,cls)=>`<div style="margin-bottom:9px">
  <div style="display:flex;justify-content:space-between;font-size:12.5px;font-weight:700;margin-bottom:4px">
  <span>${lab}</span><span class="num">${B(val)}</span></div>
  <div class="bar ${cls||''}"><i style="width:${Math.max(2,Math.min(100,val/(max||1)*100))}%"></i></div></div>`;

const VIEWS={
/* ---------- บ้าน ---------- */
house(){const s=state(),c=cycle(),per=s.left/c.daysLeft;
  const today=EXP.filter(e=>e.d===new Date().toDateString()).reduce((a,e)=>a+e.amount,0);
  return{title:'🏡 บ้านของฉัน',html:`
  <div class="sign" style="margin-bottom:12px">รอบจ่าย ${c.label} · เหลืออีก ${c.daysLeft} วัน</div>
  <div class="tiles">
    <div class="tile gold wide"><div class="lab">🪙 เงินเหลือในฟาร์ม</div>
      <div class="val num" style="font-size:38px">${B(s.left)}</div></div>
    <div class="tile fire"><div class="lab">🔥 OT รอบนี้</div><div class="val num">${B(s.ot.total)}</div></div>
    <div class="tile spend"><div class="lab">💸 ใช้ไปแล้ว</div><div class="val num">${B(s.spent)}</div></div>
    <div class="tile heart wide"><div class="lab">❤️ งบต่อวัน</div>
      <div class="val num">${B(per)}<span style="font-size:13px"> / วัน</span></div>
      <div style="margin-top:7px" class="bar pinkbar"><i style="width:${Math.max(0,Math.min(100,(1-today/Math.max(1,per))*100))}%"></i></div>
      <div style="font-size:11.5px;font-weight:700;margin-top:5px">วันนี้ใช้ไป ${B(today)} · เหลือ ${B(Math.max(0,per-today))}</div></div>
  </div>
  <div class="plank" style="margin-top:12px">
    <div class="row"><span>☀️ เงินเดือน + เบี้ยเลี้ยง</span><b>${B(s.salary+s.perDay)}</b></div>
    <div class="row"><span>🚜 OT</span><b class="pos">+${B(s.ot.total)}</b></div>
    <div class="row"><span>📉 รายการหัก</span><b class="neg">-${B(s.ded)}</b></div>
    <div class="row"><span>🛒 รายจ่าย</span><b class="neg">-${B(s.spent)}</b></div>
    <div class="row" style="font-size:16px"><span><b>🪙 เหลือ</b></span><b>${B(s.left)}</b></div>
  </div>
  <div class="plank" style="background:linear-gradient(180deg,#FFEFF3,#FFE2E9);border-color:#F5C6D2">
    <div class="row"><span>ถ้ารอบนี้ไม่ทำ OT</span><b>${B(s.noOt)}</b></div>
    <div class="row"><span>ทำ OT แล้ว</span><b>${B(s.left)}</b></div>
    <div class="sign" style="margin-top:8px;background:linear-gradient(180deg,#FF9FB6,#F4738F);border-color:#DB5A78;box-shadow:0 5px 0 #C24A66">
      🔥 OT ช่วยเพิ่มเงินให้ ${B(s.ot.total)}</div>
  </div>`};},

/* ---------- ยุ้งเก็บเงิน ---------- */
barn(){const s=state(),mx=Math.max(s.income,s.spent,s.ot.total,1);
  return{title:'🪙 ยุ้งเก็บเงิน',html:`
  <div class="sign" style="margin-bottom:12px;font-size:26px;font-family:Fredoka">${B(s.left)}
    <div style="font-size:12px;opacity:.9">เงินที่เหลืออยู่ในฟาร์ม</div></div>
  ${barRow('💰 รายรับรวม',s.income,mx)}
  ${barRow('💸 รายจ่าย',s.spent+s.ded,mx,'pinkbar')}
  ${barRow('🔥 OT',s.ot.total,mx)}
  ${barRow('📦 เก็บได้',Math.max(0,s.left),mx)}
  <div class="plank" style="margin-top:12px">
    <div class="row"><span>ฐานเงินเดือน + เบี้ยต่าง ๆ</span><b>${B(s.salary)}</b></div>
    <div class="row"><span>🍚 ค่าข้าว / ข้าว OT / ค่ากะ</span><b>${B(s.perDay)}</b></div>
    <div class="row"><span>🚜 OT (${toHM(Object.values(H).reduce((a,x)=>a+x,0))} ชม.)</span><b>${B(s.ot.total)}</b></div>
    <div class="row"><span>📉 ประกันสังคม + กองทุน + เงินกู้</span><b class="neg">-${B(s.ded)}</b></div>
  </div>
  <button class="btn ghost sm" onclick="openSheet('year')">📅 ดูสรุปรายปี</button>`};},

/* ---------- OT ---------- */
ot(){const s=state();
  const HM=k=>{const t=Math.round((H[k]||0)*60);return{h:Math.floor(t/60)||'',m:t%60||''}};
  const filled=OTEngine.buckets.filter(b=>(H[b.k]||0)>0).length;
  return{title:'🚜 กรอกชั่วโมง OT',html:`
  <p class="note" style="margin:0 0 11px">ดู <b>แถวรวมล่างสุด</b> ของใบรายงาน แล้วใส่ตัวเลขตามคอลัมน์
  ช่องไหนไม่มีก็ข้ามได้เลย</p>
  <div class="otProg"><div class="bar"><i id="otProgBar" style="width:${filled/6*100}%"></i></div>
    <span class="cnt" id="otProgCnt">${filled}/6</span></div>

  ${OTEngine.buckets.map((b,i)=>{const v=HM(b.k);
    return `<div class="otc${(H[b.k]||0)>0?' on':''}" id="c-${b.k}" style="animation-delay:${i*55}ms">
      <div class="top"><div class="ic" style="background:${b.bg}">${b.ico}</div>
        <div style="flex:1;min-width:0"><div class="nm">คอลัมน์ “${b.col}”</div>
          <div class="sub">${b.name} · ${B2(s.ot.rates[b.k])}/ชม.</div></div>
        <div class="money" id="am-${b.k}">${B(s.ot.lines[b.k])}</div></div>
      <div class="tin">
        <div class="unit" id="uh-${b.k}">
          <input id="h-${b.k}" type="number" inputmode="numeric" pattern="[0-9]*" min="0"
            placeholder="0" value="${v.h}"><span class="u">ชม.</span></div>
        <div class="unit" id="um-${b.k}">
          <input id="m-${b.k}" type="number" inputmode="numeric" pattern="[0-9]*" min="0" max="59"
            placeholder="0" value="${v.m}"><span class="u">นาที</span></div>
        <button class="wipe" data-wipe="${b.k}" aria-label="ล้างช่องนี้">✕</button></div>
      <div class="mlab">👆 แตะเลือกนาทีได้เลย</div>
      <div class="mchips">${[0,15,30,45].map(x=>
        `<button data-mk="${b.k}" data-mv="${x}"${((H[b.k]||0)>0&&(v.m||0)===x)?' class="on"':''}>:${String(x).padStart(2,'0')}</button>`).join('')}</div>
    </div>`}).join('')}

  <div class="sign" style="margin:4px 0 14px">💰 รวมเงิน OT
    <div class="bigtotal" id="otTotalSign">${B(s.ot.total)}</div></div>

  <div class="plank">
    <h3 style="margin:0 0 4px;font-size:15px">🍚 เบี้ยเลี้ยง</h3>
    <p class="note" style="margin-bottom:9px">ใส่เป็นจำนวนวัน (ดูช่องค่าอาหาร / ค่าอาหารล่วงเวลา / ค่ากะ ในใบ)</p>
    <div class="grid2">
      <div><label class="f">ค่าอาหาร (วัน)</label>
        <input id="dMeal" type="number" inputmode="numeric" pattern="[0-9]*" min="0" placeholder="0" value="${D.meal||''}"></div>
      <div><label class="f">ค่าอาหารล่วงเวลา (วัน)</label>
        <input id="dOtMeal" type="number" inputmode="numeric" pattern="[0-9]*" min="0" placeholder="0" value="${D.otMeal||''}"></div></div>
    <label class="f">ค่ากะ (จำนวนกะ)</label>
    <input id="dShift" type="number" inputmode="numeric" pattern="[0-9]*" min="0" placeholder="0" value="${D.shift||''}">
    <div class="row" style="margin-top:11px"><span>รวมเบี้ยเลี้ยง</span>
      <b class="pos" id="perDaySum">+${B(s.perDay)}</b></div>
  </div>

  <button class="btn" id="otDone">✓ เสร็จแล้ว</button>
  <div style="height:10px"></div>
  <button class="btn ghost sm" id="otClear">🧹 ล้างตัวเลขทั้งหมด</button>`,
  after(){
    const chips=k=>{const m=Math.round(((H[k]||0)*60)%60);
      $('sheetBody').querySelectorAll('[data-mk="'+k+'"]').forEach(c=>
        c.classList.toggle('on',(H[k]||0)>0&&+c.dataset.mv===m))};
    const bumpProg=()=>{const f=OTEngine.buckets.filter(b=>(H[b.k]||0)>0).length;
      $('otProgBar').style.width=f/6*100+'%';$('otProgCnt').textContent=f+'/6'};
    const pull=(k,ring)=>{
      const hi=$('h-'+k),mi=$('m-'+k);
      let mv=n(mi.value);
      if(mv>59){mi.value=59;mv=59;const u=$('um-'+k);
        u.classList.remove('bad');void u.offsetWidth;u.classList.add('bad');
        toast('นาทีใส่ได้ไม่เกิน 59')}
      H[k]=n(hi.value)+mv/60;
      const card=$('c-'+k);
      card.classList.toggle('on',H[k]>0);
      card.classList.remove('pop');void card.offsetWidth;card.classList.add('pop');
      if(ring){card.classList.remove('ring');void card.offsetWidth;card.classList.add('ring')}
      chips(k);bumpProg();render();saveSoon();
    };
    OTEngine.buckets.forEach(b=>['h-','m-'].forEach(pre=>
      $(pre+b.k).addEventListener('input',()=>pull(b.k))));
    $('sheetBody').querySelectorAll('[data-mk]').forEach(btn=>btn.onclick=e=>{
      const k=btn.dataset.mk,mv=+btn.dataset.mv;
      $('m-'+k).value=mv||'';
      sparkle(e.currentTarget);pull(k,1);
      if(!n($('h-'+k).value))$('h-'+k).focus();
      try{navigator.vibrate&&navigator.vibrate(12)}catch(err){}});
    $('sheetBody').querySelectorAll('[data-wipe]').forEach(btn=>btn.onclick=()=>{
      const k=btn.dataset.wipe;$('h-'+k).value='';$('m-'+k).value='';pull(k)});
    [['dMeal','meal'],['dOtMeal','otMeal'],['dShift','shift']].forEach(([id,k])=>
      $(id).addEventListener('input',e=>{D[k]=n(e.target.value);render();saveSoon()}));
    $('otDone').onclick=()=>{save();closeSheet();coins()};
    $('otClear').onclick=()=>{H={h1:0,h15:0,h3:0,h15p:0,h2p:0,h3p:0};D={meal:0,otMeal:0,shift:0};
      render();save();renderSheet('ot');toast('ล้างตัวเลขแล้ว 🧹')};
  }};},

/* ---------- ตลาด ---------- */
market(){const s=state(),byCat={};EXP.forEach(e=>byCat[e.cat]=(byCat[e.cat]||0)+e.amount);
  const mx=Math.max(1,...Object.values(byCat),1),cat=k=>CATS.find(c=>c.k===k)||CATS[6];
  return{title:'🛒 ตลาด',html:`
  <div class="plank">
    <input id="quick" placeholder="เช่น  กินข้าว 80" autocomplete="off" style="font-family:Mali">
    <div class="chips" id="catChips">${CATS.map((c,i)=>
      `<button class="chip${i?'':' on'}" data-c="${c.k}">${c.i} ${c.n}</button>`).join('')}</div>
    <div style="height:12px"></div><button class="btn sm" id="addBtn">＋ เพิ่มรายจ่าย</button>
    <p class="note" style="margin:9px 0 0">พิมพ์ชื่อกับตัวเลขติดกันได้เลย ระบบเดาหมวดให้เอง</p>
  </div>
  <div class="sign" style="margin-bottom:12px">💸 รายจ่ายรอบนี้ ${B(s.spent)}</div>
  ${EXP.length?CATS.filter(c=>byCat[c.k]).map(c=>`
    <div style="margin-bottom:11px">
      <div class="exp" style="border:0;padding:0 0 5px"><div class="ic">${c.i}</div>
        <b style="flex:1;font-size:14px">${c.n}</b><b class="num">${B(byCat[c.k])}</b></div>
      <div class="bar pinkbar"><i style="width:${byCat[c.k]/mx*100}%"></i></div></div>`).join('')
   :'<div class="empty"><span class="ei">🧺</span>ยังไม่มีรายจ่ายรอบนี้<br>พิมพ์ด้านบนเพื่อเพิ่มรายการแรกได้เลย</div>'}
  ${EXP.length?`<h3 style="margin:18px 0 2px;font-size:15px">🧾 รายการทั้งหมด</h3>
    <div class="swHint">◀ ปัดซ้ายที่รายการเพื่อลบ</div>
    ${EXP.map((e,i)=>`<div class="sw"><button class="del" data-del="${i}"><span class="di">🗑️</span>ลบ</button>
      <div class="fr"><div class="exp" style="border:0;padding:0">
        <div class="ic">${cat(e.cat).i}</div>
        <div style="flex:1;min-width:0"><b style="font-size:14px">${esc(e.label)}</b>
          <div class="note">${cat(e.cat).n}</div></div>
        <b class="num neg">-${B(e.amount)}</b></div></div></div>`).reverse().join('')}`:''}`,
  after(){
    $('catChips').onclick=e=>{const c=e.target.closest('.chip');if(!c)return;
      $('catChips').querySelectorAll('.chip').forEach(x=>x.classList.remove('on'));c.classList.add('on')};
    $('addBtn').onclick=addQuick;
    $('quick').addEventListener('keydown',e=>{if(e.key==='Enter')addQuick()});
    $('sheetBody').querySelectorAll('[data-del]').forEach(btn=>btn.onclick=()=>{
      EXP.splice(+btn.dataset.del,1);render();save();toast('ลบรายการแล้ว 🗑️')});
  }};},

/* ---------- สวนเงินเก็บ ---------- */
garden(){const tot=GOALS.reduce((a,g)=>a+g.s,0);
  return{title:'🌱 สวนเงินเก็บ',html:`
  <div class="sign" style="margin-bottom:14px">🌾 ปลูกไว้แล้วทั้งหมด ${B(tot)}</div>
  ${GOALS.length?`<div class="swHint">◀ ปัดซ้ายที่เป้าหมายเพื่อลบ</div>`+GOALS.map((g,i)=>{
    const p=Math.min(100,g.s/g.t*100);
    const st=p>=100?'🌳':p>=75?'🌻':p>=50?'🌾':p>=25?'🌿':'🌱';
    return `<div class="sw"><button class="del" data-gdel="${i}"><span class="di">🗑️</span>ลบ</button>
      <div class="fr" style="padding:13px 15px;background:linear-gradient(180deg,#FFF6E2,#FFEDD0);border-color:#EBD6AC">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
        <div style="font-size:30px">${st}</div>
        <div style="flex:1;min-width:0"><b style="font-size:15px">${g.i} ${esc(g.n)}</b>
          <div class="note">${B(g.s)} / ${B(g.t)} · ${Math.floor(p)}%</div></div>
        ${p>=100?'<div style="font-size:22px">🏆</div>':''}</div>
      <div class="bar"><i style="width:${p}%"></i></div>
      <div class="btn2" style="margin-top:10px">
        <button class="btn sm ghost" data-w="${i}" data-a="-500">− ฿500</button>
        <button class="btn sm" data-w="${i}" data-a="500">＋ ฿500</button></div></div></div>`}).join('')
   :'<div class="empty"><span class="ei">🌱</span>ยังไม่มีเป้าหมาย<br>ปลูกเป้าหมายแรกด้านล่างได้เลย</div>'}
  <div class="plank" style="margin-top:14px">
    <label class="f">เป้าหมายใหม่</label>
    <div class="grid2"><input id="gn" placeholder="ชื่อ" style="font-family:Mali">
      <input id="gt" type="number" inputmode="numeric" placeholder="จำนวนเงิน"></div>
    <div style="height:10px"></div><button class="btn sm" id="gAdd">🌱 ปลูกเป้าหมายใหม่</button></div>`,
  after(){
    $('sheetBody').querySelectorAll('[data-w]').forEach(b=>b.onclick=()=>{
      const g=GOALS[+b.dataset.w],before=g.s>=g.t;
      g.s=Math.max(0,Math.min(g.t,g.s+ +b.dataset.a));
      if(!before&&g.s>=g.t){confetti();toast('🏆 สำเร็จแล้ว: '+g.n)}
      render();save()});
    $('sheetBody').querySelectorAll('[data-gdel]').forEach(b=>b.onclick=()=>{
      GOALS.splice(+b.dataset.gdel,1);render();save();toast('ลบเป้าหมายแล้ว 🗑️')});
    $('gAdd').onclick=()=>{const nm=$('gn').value.trim(),t=n($('gt').value);
      if(!nm||!t)return toast('ใส่ชื่อกับจำนวนเงินด้วยนะ');
      GOALS.push({n:nm,t,s:0,i:'🎯'});render();save();toast('ปลูกเป้าหมายใหม่แล้ว 🌱')};
  }};},

/* ---------- กระดานเป้าหมาย ---------- */
board(){return{title:'📋 กระดานเป้าหมาย',html:`
  ${GOALS.length?'<p class="note" style="margin:0 0 12px">แตะ 🌱 สวนเงินเก็บ เพื่อหยอดเงินเข้าเป้าหมาย</p>'
   :'<div class="empty"><span class="ei">📋</span>กระดานยังว่างอยู่<br>ไปสร้างเป้าหมายที่ 🌱 สวนเงินเก็บ</div>'}
  ${GOALS.map(g=>{const p=Math.min(100,g.s/g.t*100),done=p>=100;
    return `<div class="plank" style="${done?'background:linear-gradient(180deg,#EAF9E4,#D6F2CB);border-color:#B4E0A5':''}">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <b style="font-size:15px">${g.i} ${esc(g.n)}</b>
        <b class="num" style="font-size:13px">${B(g.s)} / ${B(g.t)}</b></div>
      <div class="bar"><i style="width:${p}%"></i></div>
      <div style="margin-top:8px;font-size:12.5px;font-weight:700;color:${done?'#3E9B4F':'#9A8A6A'}">
        ${done?'🏆 ORDER COMPLETE!':'เหลืออีก '+B(g.t-g.s)}</div></div>`}).join('')}`};},

/* ---------- ตั้งค่า ---------- */
settings(){const s=state();
  return{title:'⚙️ ตั้งค่า',html:`
  <div class="plank"><h3 style="margin:0 0 4px;font-size:15px">☀️ ฐานเงินเดือน</h3>
    <p class="note" style="margin-bottom:2px">4 ช่องแรก (รวมค่าเช่าบ้าน) คือฐานที่ใช้คิดเรต OT</p>
    <label class="f">ฐานเงินเดือน</label><input data-s="base" type="number" inputmode="decimal" value="${S.base||''}">
    <div class="grid2">
      <div><label class="f">ค่าครองชีพ</label><input data-s="col" type="number" value="${S.col||''}"></div>
      <div><label class="f">ค่าตำแหน่ง</label><input data-s="pos" type="number" value="${S.pos||''}"></div></div>
    <div class="grid2">
      <div><label class="f">ค่าเช่าบ้าน</label><input data-s="house" type="number" value="${S.house||''}"></div>
      <div><label class="f">ค่าสภาพแวดล้อม</label><input data-s="env" type="number" value="${S.env||''}"></div></div>
    <div class="grid2">
      <div><label class="f">เบี้ยขยัน</label><input data-s="dili" type="number" value="${S.dili||''}"></div>
      <div><label class="f">โบนัส</label><input data-s="bonus" type="number" value="${S.bonus||''}"></div></div></div>
  <div class="plank"><h3 style="margin:0 0 6px;font-size:15px">🍚 เรตเบี้ยเลี้ยง</h3>
    <div class="grid2">
      <div><label class="f">ค่าข้าว / วัน</label><input data-s="mealRate" type="number" value="${S.mealRate||''}"></div>
      <div><label class="f">ข้าว OT / วัน</label><input data-s="otMealRate" type="number" value="${S.otMealRate||''}"></div></div>
    <label class="f">ค่ากะ / กะ</label><input data-s="shiftRate" type="number" value="${S.shiftRate||''}"></div>
  <div class="plank"><h3 style="margin:0 0 6px;font-size:15px">📉 รายการหัก</h3>
    <div class="grid2">
      <div><label class="f">ประกันสังคม</label><input data-s="sso" type="number" value="${S.sso||''}"></div>
      <div><label class="f">กองทุนสำรอง</label><input data-s="pvd" type="number" value="${S.pvd||''}"></div></div>
    <label class="f">เงินกู้ยืม</label><input data-s="loan" type="number" value="${S.loan||''}"></div>
  <div class="plank"><h3 style="margin:0 0 6px;font-size:15px">🧮 สูตรเรต OT</h3>
    <select id="strictSel">
      <option value="0"${STRICT?'':' selected'}>ใช้ฐานเดียวกันทุกประเภท (แนะนำ)</option>
      <option value="1"${STRICT?' selected':''}>ตาม Excel เป๊ะ — นักขัตฤกษ์ไม่รวมค่าเช่าบ้าน</option></select>
    <div class="warnbox" style="margin-top:11px">⚠️ ใน Cal_OT.xlsx ช่องนักขัตฤกษ์ใช้ฐาน <b>ไม่รวมค่าเช่าบ้าน</b> ต่างจากช่องอื่น
      และไม่มีบรรทัดรองรับคอลัมน์ <b>1.5 Public</b> ที่มีในใบรายงาน</div>
    <div style="height:12px"></div>
    <div id="rateTbl">${rateTblHtml()}</div></div>
  <button class="btn ghost sm" id="resetBtn">🔄 เริ่มรอบใหม่ (ล้าง OT + รายจ่าย)</button>
  <div style="height:10px"></div>
  <button class="btn ghost sm" id="wipeAll" style="color:#E0555B">🗑️ ล้างข้อมูลทั้งหมด (รวมประวัติรายปี)</button>`,
  after(){
    $('sheetBody').querySelectorAll('[data-s]').forEach(el=>
      el.addEventListener('input',e=>{S[el.dataset.s]=n(e.target.value);render();saveSoon()}));
    $('strictSel').onchange=e=>{STRICT=+e.target.value;render();save()};
    $('resetBtn').onclick=()=>{H={h1:0,h15:0,h3:0,h15p:0,h2p:0,h3p:0};D={meal:0,otMeal:0,shift:0};EXP=[];
      render();save();toast('เริ่มรอบใหม่แล้ว 🌱')};
    let armed=0;
    $('wipeAll').onclick=e=>{if(!armed){armed=1;e.target.textContent='⚠️ แตะอีกครั้งเพื่อยืนยันการล้าง';
        setTimeout(()=>{armed=0;if($('wipeAll'))$('wipeAll').textContent='🗑️ ล้างข้อมูลทั้งหมด (รวมประวัติรายปี)'},4000);return}
      H={h1:0,h15:0,h3:0,h15p:0,h2p:0,h3p:0};D={meal:0,otMeal:0,shift:0};EXP=[];GOALS=[];YEARS={};
      render();save();toast('ล้างข้อมูลทั้งหมดแล้ว 🌱');openSheet('settings')};
  }};},

/* ---------- รายปี ---------- */
year(){
  const yr=YEARS[viewYear]||{},c=cycle();
  const ms=Object.keys(yr).map(Number);
  const tot=ms.reduce((a,m)=>({income:a.income+yr[m].income,ot:a.ot+yr[m].ot,
    expense:a.expense+yr[m].expense,left:a.left+yr[m].left}),{income:0,ot:0,expense:0,left:0});
  const maxLeft=Math.max(1,...ms.map(m=>yr[m].left));
  const stage=v=>{const p=v/maxLeft;return v<=0?'🥀':p<.25?'🌱':p<.5?'🌿':p<.75?'🌾':p<1?'🌻':'🌳'};
  const best=k=>ms.length?ms.reduce((a,b)=>yr[b][k]>yr[a][k]?b:a):null;
  const bLeft=best('left'),bOt=best('ot'),bExp=best('expense');
  const bRate=ms.length?ms.reduce((a,b)=>(yr[b].left/Math.max(1,yr[b].income))>(yr[a].left/Math.max(1,yr[a].income))?b:a):null;
  const treeP=Math.min(1,tot.left/120000);
  const R=26+treeP*44;
  return{title:'📅 ฟาร์มรายปี',html:`
  <div class="yearHead"><button id="yPrev">◀</button>
    <div class="y">${viewYear}</div><button id="yNext">▶</button></div>

  <div class="yTree">
    <svg width="190" height="150" viewBox="0 0 190 150">
      <ellipse cx="95" cy="140" rx="${34+treeP*30}" ry="9" fill="#6BBE5E" opacity=".35"/>
      <path d="M88 140 q-3 -32 7 -50 l10 2 q-9 20 -5 48Z" fill="#8B5E3C"/>
      <circle cx="95" cy="${96-R*.6}" r="${R}" fill="#57A84B"/>
      <circle cx="${95-R*.7}" cy="${104-R*.4}" r="${R*.66}" fill="#6BBE5E"/>
      <circle cx="${95+R*.7}" cy="${104-R*.4}" r="${R*.7}" fill="#6BBE5E"/>
      <circle cx="95" cy="${84-R*.6}" r="${R*.66}" fill="#7DD06A"/>
      ${treeP>.5?'<circle cx="72" cy="70" r="5" fill="#FF8FAB"/><circle cx="118" cy="78" r="4.4" fill="#FFD166"/>':''}
      ${treeP>.85?'<text x="150" y="46" font-size="20">✨</text>':''}
    </svg></div>
  <div class="sign" style="margin-bottom:12px">🌾 ${viewYear} FARM REPORT
    <div style="font-size:12px;opacity:.9;font-weight:400">ต้นไม้โตตามเงินที่เก็บได้ทั้งปี</div></div>
  <div class="tiles" style="margin-bottom:14px">
    <div class="tile gold"><div class="lab">💰 รายรับ</div><div class="val num" style="font-size:19px">${B(tot.income)}</div></div>
    <div class="tile fire"><div class="lab">🔥 OT</div><div class="val num" style="font-size:19px">${B(tot.ot)}</div></div>
    <div class="tile spend"><div class="lab">💸 รายจ่าย</div><div class="val num" style="font-size:19px">${B(tot.expense)}</div></div>
    <div class="tile heart"><div class="lab">🪙 เก็บได้</div><div class="val num" style="font-size:19px">${B(tot.left)}</div></div>
  </div>

  <h3 style="margin:0 0 8px;font-size:15px">🌾 แปลงฟาร์ม 12 เดือน</h3>
  <div class="plots">${MOE.map((mo,i)=>{const d=yr[i];
    return `<div class="plot ${d?'':'empty'} ${(viewYear===c.y&&i===c.m)?'cur':''}" data-m="${i}">
      <div class="mo">${mo}</div><div class="pl">${d?stage(d.left):'▫️'}</div>
      <div class="rm">${d?B(d.left):'—'}</div></div>`}).join('')}</div>
  <p class="note" style="margin:8px 2px 14px">แตะแปลงเพื่อดูรายละเอียดของเดือนนั้น · เดือนที่ยังไม่มีข้อมูลจะเป็นดินเปล่า</p>

  ${ms.length?`<h3 style="margin:0 0 8px;font-size:15px">🏅 เหรียญประจำปี</h3>
  <div class="badges" style="margin-bottom:14px">
    <div class="badge"><div class="bi">🏆</div><div><div class="bt">เหลือเงินมากสุด</div>
      <div class="bv">${MOE[bLeft]} · ${B(yr[bLeft].left)}</div></div></div>
    <div class="badge"><div class="bi">🔥</div><div><div class="bt">OT มากสุด</div>
      <div class="bv">${MOE[bOt]} · ${B(yr[bOt].ot)}</div></div></div>
    <div class="badge"><div class="bi">💸</div><div><div class="bt">ใช้จ่ายมากสุด</div>
      <div class="bv">${MOE[bExp]} · ${B(yr[bExp].expense)}</div></div></div>
    <div class="badge"><div class="bi">🌱</div><div><div class="bt">เก็บเก่งสุด</div>
      <div class="bv">${MOE[bRate]} · ${Math.round(yr[bRate].left/Math.max(1,yr[bRate].income)*100)}%</div></div></div>
  </div>`:''}
  <button class="btn ghost sm" id="cmpBtn">⚖️ เทียบเดือนล่าสุดกับเดือนก่อน</button>`,
  after(){
    $('yPrev').onclick=()=>{viewYear--;renderSheet('year')};
    $('yNext').onclick=()=>{viewYear++;renderSheet('year')};
    $('sheetBody').querySelectorAll('.plot').forEach(p=>p.onclick=()=>monthDetail(+p.dataset.m));
    $('cmpBtn').onclick=()=>compare();
  }};},
};

/* ---------- รายละเอียดเดือน / เปรียบเทียบ ---------- */
let mDetail=0;
function monthDetail(m){mDetail=m;VIEWS.month=()=>{
  const yr=YEARS[viewYear]||{},d=yr[m],c=cycle();
  if(!d)return{title:`${MOE[m]} ${viewYear}`,html:`<p class="note">ยังไม่มีข้อมูลของเดือนนี้ — พอถึงรอบจ่ายเดือนนี้ ระบบจะบันทึกให้อัตโนมัติ</p>
    <button class="btn ghost sm" onclick="openSheet('year')">← กลับไปหน้ารายปี</button>`};
  const days=new Date(viewYear,m+1,0).getDate(),mx=Math.max(d.income,d.expense,1);
  return{title:`${d.left>=0?'🌻':'🥀'} ${MOE[m]} ${viewYear}`,html:`
    <div class="tiles" style="margin-bottom:14px">
      <div class="tile gold"><div class="lab">💰 รายรับ</div><div class="val num" style="font-size:20px">${B(d.income)}</div></div>
      <div class="tile fire"><div class="lab">🔥 OT</div><div class="val num" style="font-size:20px">${B(d.ot)}</div></div>
      <div class="tile spend"><div class="lab">💸 รายจ่าย</div><div class="val num" style="font-size:20px">${B(d.expense)}</div></div>
      <div class="tile heart"><div class="lab">🪙 เหลือ</div><div class="val num" style="font-size:20px">${B(d.left)}</div></div>
    </div>
    ${barRow('💰 รายรับ',d.income,mx)}${barRow('🔥 OT',d.ot,mx)}${barRow('💸 รายจ่าย',d.expense,mx,'pinkbar')}
    <div class="sign" style="margin:12px 0">❤️ งบต่อวันเฉลี่ย ${B(d.left/days)} / วัน</div>
    <div class="plank"><div class="row"><span>OT คิดเป็นสัดส่วนรายรับ</span>
      <b>${Math.round(d.ot/Math.max(1,d.income)*100)}%</b></div>
      <div class="row"><span>เก็บได้จากรายรับ</span><b>${Math.round(d.left/Math.max(1,d.income)*100)}%</b></div>
      <div class="row"><span>ถ้าไม่มี OT เดือนนี้</span><b>${B(d.left-d.ot)}</b></div></div>
    <button class="btn ghost sm" onclick="openSheet('year')">← กลับไปหน้ารายปี</button>`};};
  openSheet('month');}

function compare(){const yr=YEARS[viewYear]||{},ms=Object.keys(yr).map(Number).sort((a,b)=>a-b);
  if(ms.length<2)return toast('ต้องมีข้อมูลอย่างน้อย 2 เดือน');
  const b=ms[ms.length-1],a=ms[ms.length-2];
  const line=(lab,k,inv)=>{const dv=yr[b][k]-yr[a][k],up=dv>=0,good=inv?!up:up;
    return `<div class="cmp"><div class="side"><div class="k">${MOE[a]}</div><div class="v">${B(yr[a][k])}</div></div>
      <div class="arw" style="color:${good?'#3E9B4F':'#E0555B'}">${up?'↑':'↓'} ${B(Math.abs(dv))}</div>
      <div class="side"><div class="k">${MOE[b]}</div><div class="v">${B(yr[b][k])}</div></div></div>
      <div class="note" style="text-align:center;margin:-4px 0 8px">${lab}</div>`};
  VIEWS.cmp=()=>({title:`⚖️ ${MOE[a]} vs ${MOE[b]}`,html:
    line('🔥 OT','ot')+line('💸 รายจ่าย','expense',1)+line('🪙 เงินเหลือ','left')+line('💰 รายรับ','income')+
    `<button class="btn ghost sm" style="margin-top:8px" onclick="openSheet('year')">← กลับไปหน้ารายปี</button>`});
  openSheet('cmp');}

/* =====================================================================
   ACTIONS
   ===================================================================== */
function addQuick(){const el=$('quick'),t=el.value.trim();if(!t)return;
  const m=t.match(/([\d,]+(?:\.\d+)?)\s*$/)||t.match(/([\d,]+(?:\.\d+)?)/);
  if(!m)return toast('ใส่จำนวนเงินด้วยนะ');
  const amount=n(m[1].replace(/,/g,''));if(!amount)return toast('ใส่จำนวนเงินด้วยนะ');
  const label=t.replace(m[0],'').trim()||'รายจ่าย';let cat=null;
  for(const k in KW)if(KW[k].some(w=>label.toLowerCase().includes(w))){cat=k;break}
  cat=cat||$('catChips').querySelector('.chip.on').dataset.c;
  EXP.push({label,amount,cat,d:new Date().toDateString()});
  el.value='';render();save();
  toast(`${CATS.find(x=>x.k===cat).i} ${label} ${B(amount)}`);}

/* =====================================================================
   FX
   ===================================================================== */
function coins(){const tgt=$('hCoin').getBoundingClientRect();
  for(let i=0;i<10;i++){const c=document.createElement('div');c.className='coin';c.textContent='฿';
    const sx=window.innerWidth/2,sy=window.innerHeight*.62;
    c.style.left=sx+'px';c.style.top=sy+'px';document.body.appendChild(c);
    c.animate([{transform:`translate(${(Math.random()-.5)*100}px,${-70-Math.random()*50}px) scale(1.2)`,opacity:1},
      {transform:`translate(${tgt.left-sx}px,${tgt.top-sy}px) scale(.3)`,opacity:0}],
      {duration:900+i*70,easing:'cubic-bezier(.3,-0.2,.5,1)',fill:'forwards'});
    setTimeout(()=>c.remove(),1050+i*70)}
  toast('🪙 เงิน OT เข้าฟาร์มแล้ว!');}
function confetti(){const cs=['#FFD166','#FF8FAB','#7BC96F','#7DD3FC','#A78BFA'];
  for(let i=0;i<34;i++){const p=document.createElement('div');p.className='conf-p';
    p.style.background=cs[i%cs.length];p.style.left=(window.innerWidth/2)+'px';p.style.top='30%';
    document.body.appendChild(p);
    p.animate([{transform:'translate(0,0) rotate(0)',opacity:1},
      {transform:`translate(${(Math.random()-.5)*380}px,${180+Math.random()*300}px) rotate(${Math.random()*720}deg)`,opacity:0}],
      {duration:1300+Math.random()*700,easing:'cubic-bezier(.2,.6,.4,1)',fill:'forwards'});
    setTimeout(()=>p.remove(),2100)}}
let tt;function toast(m){const e=$('toast');e.textContent=m;e.classList.add('on');
  clearTimeout(tt);tt=setTimeout(()=>e.classList.remove('on'),1900)}

/* =====================================================================
   BOOT
   ===================================================================== */
$('eyeBtn').onclick=e=>{e.stopPropagation();HIDE=HIDE?0:1;render();save();
  toast(HIDE?'ซ่อนยอดเงินแล้ว 🙈':'แสดงยอดเงินแล้ว 👁️')};
$('mTap').onclick=()=>openSheet('house');

/* ---------- ปัดซ้ายเพื่อลบ ---------- */
let swA=null,swX=0,swY=0,swD=0,swLock=0;
function swStart(el,x,y){swA=el;swX=x;swY=y;swD=0;swLock=0;el.querySelector('.fr').style.transition='none'}
function swMove(x,y){if(!swA)return;const dx=x-swX,dy=y-swY;
  if(!swLock){if(Math.abs(dx)<8&&Math.abs(dy)<8)return;swLock=Math.abs(dx)>Math.abs(dy)?1:-1;
    if(swLock<0){swEnd();return}}
  swD=dx;const base=swA.classList.contains('open')?-88:0;
  swA.querySelector('.fr').style.transform='translateX('+Math.max(-88,Math.min(0,base+dx))+'px)'}
function swEnd(){if(!swA)return;const fr=swA.querySelector('.fr');fr.style.transition='';fr.style.transform='';
  if(swD<-30)swA.classList.add('open');else if(swD>30)swA.classList.remove('open');swA=null;swLock=0;swD=0}
document.addEventListener('touchmove',e=>{if(swA)swMove(e.touches[0].clientX,e.touches[0].clientY)},{passive:true});
document.addEventListener('touchend',swEnd);
document.addEventListener('mousemove',e=>{if(swA)swMove(e.clientX,e.clientY)});
document.addEventListener('mouseup',swEnd);
function bindSwipe(){document.querySelectorAll('.sw .fr').forEach(fr=>{
  if(fr.dataset.b)return;fr.dataset.b=1;
  fr.addEventListener('touchstart',e=>swStart(fr.parentElement,e.touches[0].clientX,e.touches[0].clientY),{passive:true});
  fr.addEventListener('mousedown',e=>{e.preventDefault();swStart(fr.parentElement,e.clientX,e.clientY)})})}

document.querySelectorAll('.spot').forEach(sp=>{
  sp.addEventListener('click',()=>{
    const ping=sp.querySelector('.ping');
    if(ping){ping.style.animation='none';ping.getBoundingClientRect();ping.style.animation='pingA .55s ease-out'}
    openSheet(sp.dataset.open)});
});
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{
  if(b.dataset.nav!=='ot')document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('on',x===b));
  if(b.dataset.nav==='ot'){b.classList.remove('on');
    document.querySelector('.nav [data-nav="farm"]').classList.add('on');openSheet('ot');return}
  if(b.dataset.nav==='farm')closeSheet();else openSheet(b.dataset.nav)});

/* ต้องมี service worker เบราว์เซอร์ถึงจะยอมให้ "ติดตั้งแอป" ลงหน้าจอโฮม */
if('serviceWorker' in navigator&&location.protocol==='https:')
  window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));

(async()=>{await load();applyTime();render();
  setInterval(applyTime,60000);
  setTimeout(()=>{if(!openKey)toast('แตะสิ่งของในฟาร์มเพื่อดูข้อมูล 👆')},1400);
})();
</script>
</body>
</html>
